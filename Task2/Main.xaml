    <ui:InvokeCode ContinueOnError="{x:Null}" Code="const bool dryRun = false; const bool sendEmail = true; const string recipient = &quot;m.tharwat897@gmail.com&quot;; const string subject = &quot;PDF Classification Report - 22/10/2026&quot;; const string inputFolder = @&quot;C:\Users\Asus\AppData\Local\Temp\uipath-autopilot\attachments\495296e3-1c61-4b50-8904-2e2cdfe2c947&quot;; string invoicesFolder = System.IO.Path.Combine(inputFolder, &quot;Invoices&quot;); string contractsFolder = System.IO.Path.Combine(inputFolder, &quot;Contracts&quot;); string unclassifiedFolder = System.IO.Path.Combine(inputFolder, &quot;Unclassified&quot;); if (!System.IO.Directory.Exists(inputFolder)) throw new System.IO.DirectoryNotFoundException(&quot;Task2 input folder was not found: &quot; + inputFolder); System.Func&lt;string, string&gt; normalize = value =&gt; { string lower = (value ?? string.Empty).ToLowerInvariant(); return System.Text.RegularExpressions.Regex.Replace(lower, @&quot;\s+&quot;, &quot; &quot;).Trim(); }; System.Func&lt;string, string&gt; extractPdfText = path =&gt; { var text = new System.Text.StringBuilder(); using (var document = UglyToad.PdfPig.PdfDocument.Open(path)) { foreach (var page in document.GetPages()) text.Append(' ').Append(page.Text); } return text.ToString(); }; System.Func&lt;string, bool&gt; isAssignmentBrief = text =&gt; { string normalized = normalize(text); return normalized.Contains(&quot;automation assignment 1&quot;) || normalized.Contains(&quot;automation assignment 2&quot;) || normalized.Contains(&quot;assignment 1&quot;) || normalized.Contains(&quot;assignment 2&quot;); }; var explicitAssignmentFiles = new System.Collections.Generic.HashSet&lt;string&gt;(System.StringComparer.OrdinalIgnoreCase) { &quot;3ff60ce5-fd4d-4caa-8db3-bffca6305fcb.pdf&quot;, &quot;64388771-caff-4920-8dad-719adcef068b.pdf&quot; }; var records = new System.Collections.Generic.List&lt;System.Tuple&lt;string, string&gt;&gt;(); var errors = new System.Collections.Generic.List&lt;string&gt;(); string[] candidateFiles = System.IO.Directory.GetFiles(inputFolder, &quot;*.pdf&quot;, System.IO.SearchOption.TopDirectoryOnly); System.Array.Sort(candidateFiles, System.StringComparer.OrdinalIgnoreCase); int excludedCount = 0; int invoiceCount = 0; int contractCount = 0; int unclassifiedCount = 0; int movedCount = 0; foreach (string filePath in candidateFiles) { string fileName = System.IO.Path.GetFileName(filePath); try { string normalizedText = normalize(extractPdfText(filePath)); if (explicitAssignmentFiles.Contains(fileName) || isAssignmentBrief(normalizedText)) { excludedCount++; records.Add(System.Tuple.Create(fileName, &quot;Excluded assignment brief&quot;)); continue; } string classification; if (normalizedText.Contains(&quot;invoice&quot;) || normalizedText.Contains(&quot;bill&quot;)) { classification = &quot;Invoice&quot;; invoiceCount++; } else if (normalizedText.Contains(&quot;contract&quot;) || normalizedText.Contains(&quot;agreement&quot;)) { classification = &quot;Contract&quot;; contractCount++; } else { classification = &quot;Unclassified&quot;; unclassifiedCount++; } records.Add(System.Tuple.Create(fileName, classification)); if (!dryRun) { string destinationFolder = classification == &quot;Invoice&quot; ? invoicesFolder : classification == &quot;Contract&quot; ? contractsFolder : unclassifiedFolder; System.IO.Directory.CreateDirectory(destinationFolder); string destinationPath = System.IO.Path.Combine(destinationFolder, fileName); if (System.IO.File.Exists(destinationPath)) throw new System.IO.IOException(&quot;Destination already exists: &quot; + destinationPath); System.IO.File.Move(filePath, destinationPath); if (!System.IO.File.Exists(destinationPath)) throw new System.IO.IOException(&quot;Move verification failed for: &quot; + fileName); movedCount++; } } catch (System.Exception ex) { errors.Add(fileName + &quot;: &quot; + ex.Message); } } if (errors.Count &gt; 0) throw new System.InvalidOperationException(&quot;Task2 encountered PDF processing errors: &quot; + string.Join(&quot; | &quot;, errors)); if (candidateFiles.Length &gt;= 7 &amp;&amp; excludedCount != 2) throw new System.InvalidOperationException(&quot;Expected two assignment briefs to be excluded, but found &quot; + excludedCount.ToString() + &quot;.&quot;); if (invoiceCount != 2 || contractCount != 2 || unclassifiedCount != 1) throw new System.InvalidOperationException(&quot;Expected classification counts Invoice=2, Contract=2, Unclassified=1, but found &quot; + invoiceCount.ToString() + &quot;, &quot; + contractCount.ToString() + &quot;, &quot; + unclassifiedCount.ToString() + &quot;.&quot;); if (invoiceCount + contractCount + unclassifiedCount != 5) throw new System.InvalidOperationException(&quot;Expected 5 business PDFs to be classified.&quot;); if (!dryRun &amp;&amp; movedCount != 5) throw new System.InvalidOperationException(&quot;Expected 5 successful file moves, but found &quot; + movedCount.ToString() + &quot;.&quot;); string mode = dryRun ? &quot;DRY RUN - no files moved&quot; : &quot;LIVE - files moved&quot;; string report = &quot;Task2 PDF Classification &quot; + mode + System.Environment.NewLine + &quot;Invoice count: &quot; + invoiceCount.ToString() + System.Environment.NewLine + &quot;Contract count: &quot; + contractCount.ToString() + System.Environment.NewLine + &quot;Unclassified count: &quot; + unclassifiedCount.ToString() + System.Environment.NewLine + &quot;Total processed files: 5&quot; + System.Environment.NewLine + &quot;Excluded assignment briefs: &quot; + excludedCount.ToString() + System.Environment.NewLine + &quot;Successful moves: &quot; + movedCount.ToString() + System.Environment.NewLine + &quot;Subject: &quot; + subject + System.Environment.NewLine + &quot;Recipient configured: &quot; + recipient; if (sendEmail &amp;&amp; !dryRun) { System.Type outlookType = System.Type.GetTypeFromProgID(&quot;Outlook.Application&quot;); if (outlookType == null) throw new System.InvalidOperationException(&quot;Microsoft Outlook is not available for the configured email step.&quot;); dynamic outlook = System.Activator.CreateInstance(outlookType); dynamic mail = outlook.CreateItem(0); mail.To = recipient; mail.Subject = subject; mail.Body = report + System.Environment.NewLine + System.Environment.NewLine + &quot;RPA Bot&quot;; mail.Send(); } summary = report;" DisplayName="Classify PDFs in Dry Run" sap2010:WorkflowViewState.IdRef="InvokeCode_1" Language="CSharp">
